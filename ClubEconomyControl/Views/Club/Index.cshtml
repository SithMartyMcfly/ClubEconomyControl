@model List<ClubEconomyControl.Models.Club>


<h1>Lista de Clubes</h1>

<a class="btn btn-success my-4" 
asp-action="CreateClub" 
asp-controller="Club">Crear Club</a>
@foreach (var club in Model)
{
<main class="d-flex flex-row justify-content-between">
    <div class="mx-2">
			<a
                asp-action="Detail"
                asp-controller="Club"
                asp-route-id="@club.Id">
                @club.Name
            </a>
    </div>
    <div class="w-90 d-flex flex-row mb-2">
            <a 
                asp-action="CreateEconomy"
                asp-controller="Club"
			   asp-route-id="@club.Id"
            class="btn btn-warning mx-2">Ajustar Economía</a>
            <a
                asp-action="SquadList"
                asp-controller="Club"
                asp-route-id="@club.Id"
                class="btn btn-info mx-2">
                Gestión Plantilla</a>
            <a 
                asp-action="Delete"
                asp-controller="Club"
                asp-route-id="@club.Id"
                class="btn btn-danger mx2">Cesar Club</a>
    </div>
</main>
	

}

<!--esta validación queda hecha para saber hacer, no tendría efecto
  puesto que no se muestran jugadores que tengan el camo isSelled-->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

