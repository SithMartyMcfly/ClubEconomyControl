@using ClubEconomyControl.Models
@model Club




<section class="sticky-top text-center mb-4 bg-light bg-opacity-100 border rounded-3">
	<h2>@Html.DisplayFor(p => p.Name)</h2>
	<ul class="d-inline-block text-start">
		<li>Balance: @Model.Balance</li>
		<li>Limite Salarial: @Model.SquadLimitEconomy</li>
	</ul>
</section>
<section class="d-flex flex-row justify-content-center h-25 overflow-auto" style=" max-height: calc(100vh - 240px); overflow-y: auto">
	<div>
		<h4 class="sticky-top bg-white bg-opacity-100 text-decoration-underline">Datos Económicos</h4>
		<!--Poner tipo de gasto y Cantidad, después proban en BBDD-->
		@if (Model.OrdinaryIncomes != null && Model.OrdinaryIncomes.Any())
		{
			<h6>Ingresos Ordinarios</h6>
			<div class="overflow-auto">
				<ul>
					@foreach (var ordinaryIncome in Model.OrdinaryIncomes)
					{
						<!--usamos helper para que muestre la mascara del display del enum-->
						<a asp-action="EditEconomy"
						   asp-controller="Club"
						   asp-route-type="ordinaryIncome"
						   asp-route-id="@ordinaryIncome.Id"
						   class="text-decoration-none">
							@Html.DisplayFor(Model => ordinaryIncome.Type): @ordinaryIncome.Amount
						</a>
						<br />
						@if (ordinaryIncome.Description != null)
						{
							<li class="list-unstyled">@Html.DisplayFor(Model => ordinaryIncome.Description)</li>
						}
						<a asp-action="DeleteEconomy"
						   asp-controller="Club"
						   asp-route-type="ordinaryIncome"
						   asp-route-id="@ordinaryIncome.Id"
						   data-bs-toggle="modal"
						   data-bs-target="#confirmModal"
						   class="btn btn-danger py-0 px-1">
							Borrar
						</a>
						<br />
						<hr />
					}
				</ul>
			</div>
		}
		else
		{
			<p>No hay ingresos ordinarios</p>
		}
		@if (Model.OrdinaryExpenses != null && Model.OrdinaryExpenses.Any())
		{
			<h6>Gastos Ordinarios</h6>
			<div class="overflow-auto">

				<ul>
					@foreach (var ordinaryExpense in Model.OrdinaryExpenses)
					{
						<a asp-action="EditEconomy"
						   asp-controller="Club"
						   asp-route-type="ordinaryExpense"
						   asp-route-id="@ordinaryExpense.Id"
						   class="text-decoration-none">

							@Html.DisplayFor(Model => ordinaryExpense.Type) : @ordinaryExpense.Amount
						</a>
						<br />

						@if (ordinaryExpense.Description != null)
						{
							<li class="list-unstyled">@Html.DisplayFor(Model => ordinaryExpense.Description)</li>
						}

						<a asp-action="DeleteEconomy"
						   asp-controller="Club"
						   asp-route-type="ordinaryExpense"
						   asp-route-id="@ordinaryExpense.Id"
						   data-bs-toggle="modal"
						   data-bs-target="#confirmModal"
						   class="btn btn-danger py-0 px-1">
							Borrar
						</a>
						<br />
						<hr />
					}
				</ul>
			</div>
		}
		else
		{
			<p>No hay gastos ordinarios</p>
		}
		@if (Model.ExtraordinaryIncomes != null && Model.ExtraordinaryIncomes.Any())
		{
			<h6>Ingresos Extraordinarios</h6>
			<div class="overflow-auto">
				<ul>
					@foreach (var extraordinaryIncome in Model.ExtraordinaryIncomes)
					{
						<a asp-action="EditEconomy"
						   asp-controller="Club"
						   asp-route-type="extraordinaryIncome"
						   asp-route-id="@extraordinaryIncome.Id"
						   class="text-decoration-none">
							@Html.DisplayFor(Model => extraordinaryIncome.Type): @extraordinaryIncome.Amount
						</a>
						<br />

						@if (extraordinaryIncome.Description != null)
						{
							<li class="list-unstyled">@Html.DisplayFor(Model => extraordinaryIncome.Description)</li>
						}
						<a asp-action="DeleteEconomy"
						   asp-controller="Club"
						   asp-route-type="extraOrdinaryIncome"
						   asp-route-id="@extraordinaryIncome.Id"
						   data-bs-toggle="modal"
						   data-bs-target="#confirmModal"
						   class="btn btn-danger py-0 px-1">
							Borrar
						</a>
						<br />
						<hr />
					}
				</ul>
			</div>
		}
		else
		{
			<p>No hay ingresos extraordinarios</p>
		}
		@if (Model.ExtraordinaryExpenses != null && Model.ExtraordinaryExpenses.Any())
		{
			<div class="overflow-auto">
				<h6>Gastos Extraordinarios</h6>
				<ul>
					@foreach (var extraordinaryExpense in Model.ExtraordinaryExpenses)
					{
						<a asp-action="EditEconomy"
						   asp-controller="Club"
						   asp-route-type="extrardinaryExpense"
						   asp-route-id="@extraordinaryExpense.Id"
						   class="text-decoration-none">@Html.DisplayFor(Model => extraordinaryExpense.Type): @extraordinaryExpense.Amount</a>
						<br />
						@if (extraordinaryExpense.Description != null)
						{
							<li class="list-unstyled">@Html.DisplayFor(Model => extraordinaryExpense.Description)</li>
						}
						<a asp-action="DeleteEconomy"
						   asp-controller="Club"
						   asp-route-type="extraOrdinaryExpense"
						   asp-route-id="@extraordinaryExpense.Id"
						   data-bs-toggle="modal"
						   data-bs-target="#confirmModal"
						   class="btn btn-danger py-0 px-1">
							Borrar
						</a>
						<br />
						<hr />
					}
				</ul>
			</div>
		}
		else
		{
			<p>No hay gastos extraordinarios</p>
		}
	</div>
	<div class="mx-4">
		<h4 class="sticky-top bg-white bg-opacity-100 text-decoration-underline">Jugadores en plantilla</h4>
		@if (@Model.Players.Count != 0)
		{
			<p>@Model.Players.Count</p>
		}
		else
		{
			<p>No hay jugadores en plantilla</p>
		}
	</div>
</section>


<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="confirmModalLabel">Confirmación</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<p>¿Estás seguro que quieres borrar el registro?</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
				<a id="confirmDeleteBtn" class="btn btn-danger">Confirmar</a>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		var confirmModal = document.getElementById('confirmModal');
		confirmModal.addEventListener('show.bs.modal', function (event) {
			var button = event.relatedTarget;
			var deleteUrl = button.getAttribute('href');
			var confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
			confirmDeleteBtn.setAttribute('href', deleteUrl);
		});
	</script>
}

