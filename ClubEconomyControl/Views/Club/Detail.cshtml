@using ClubEconomyControl.Models
@model Club

<section class="sticky-top text-center mb-4 bg-light bg-opacity-100 border rounded-3">
	<h2>@Html.DisplayFor(p => p.Name)</h2>	
		<div class="money">Balance: @Model.Balance</div>
		<div class="money">Limite Salarial: @Model.SquadLimitEconomy</div>
</section>
<h4 class="sticky-top bg-white text-decoration-underline text-center mt-5 mb-3">Datos Económicos</h4>
<section class="d-flex flex-row justify-content-center h-25" style="width:100%">
	<div>
		<!--Poner tipo de gasto y Cantidad, después proban en BBDD-->
		<div class="d-flex flex-row justify-content-evenly">
			<a asp-controller="Economy"
			   asp-action="OrdinaryIncomes"
				asp-route-clubId="@Model.Id"
				class="btn btn-outline-success btn-sm my-3 mx-2">
				Ingresos Ordinarios
			</a>

			<a asp-controller="Economy"
			   asp-action="OrdinaryExpenses"
			   asp-route-clubId="@Model.Id"
			   class="btn btn-outline-danger btn-sm my-3 mx-2">
				Gastos Ordinarios
			</a>
		</div>
		<div class="d-flex flex-row justify-content-evenly">
			<a asp-controller="Economy"
			   asp-action="ExtraOrdinaryIncomes"
			   asp-route-clubId="@Model.Id"
			   class="btn btn-outline-success btn-sm my-3 mx-2">
				Ingresos Extraordinarios
			</a>

			<a asp-controller="Economy"
			   asp-action="ExtraOrdinaryExpenses"
			   asp-route-clubId="@Model.Id"
			   class="btn btn-outline-danger btn-sm my-3 mx-2">
				Gastos Extraordinarios
			</a>
		</div>
	
		
		
</section>


