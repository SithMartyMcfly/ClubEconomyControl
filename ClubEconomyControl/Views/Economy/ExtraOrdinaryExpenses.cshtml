@using ClubEconomyControl.Models
@model List<ExtraordinaryExpense>;


@if (Model != null && Model.Any())
{
	<div class="overflow-auto">
		<h6>Gastos Extraordinarios</h6>
		<ul>
			@foreach (var extraordinaryExpense in Model)
			{
				<a asp-action="EditEconomy"
				   asp-controller="Economy"
				   asp-route-type="extraordinaryExpense"
				   asp-route-id="@extraordinaryExpense.Id"
				   class="text-decoration-none">@Html.DisplayFor(Model => extraordinaryExpense.Type): @extraordinaryExpense.Amount</a>
				<br />
				@if (extraordinaryExpense.Description != null)
				{
					<li class="list-unstyled">@Html.DisplayFor(Model => extraordinaryExpense.Description)</li>
				}
				<a asp-action="DeleteEconomy"
				   asp-controller="Economy"
				   asp-route-type="extraOrdinaryExpense"
				   asp-route-id="@extraordinaryExpense.Id"
				   data-bs-toggle="modal"
				   data-bs-target="#confirmModal"
				   class="btn btn-danger py-0 px-1">
					Borrar
				</a>
				<br />
			}
		</ul>
	</div>
}
else
{
	<p>No hay gastos extraordinarios</p>
}

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="confirmModalLabel">Confirmación</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				<p>¿Estás seguro que quieres borrar el registro?</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
				<a id="confirmDeleteBtn" class="btn btn-danger">Confirmar</a>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		var confirmModal = document.getElementById('confirmModal');
		confirmModal.addEventListener('show.bs.modal', function (event) {
			var button = event.relatedTarget;
			var deleteUrl = button.getAttribute('href');
			var confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
			confirmDeleteBtn.setAttribute('href', deleteUrl);
		});
	</script>
}


